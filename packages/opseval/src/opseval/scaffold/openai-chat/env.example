# Copy to .env (Opseval reads it automatically) and fill in.

# Every host that receives a conversation or a key must be listed: your agent,
# the LLM endpoints and Langfuse. Comma-separated.
OPSEVAL_ALLOWED_HOSTS=your-agent.example.com

# Sent to your agent as "Authorization: Bearer <token>".
# OPSEVAL_STATIC_TOKEN=

# LLM-played customer and judge (any OpenAI-compatible endpoint).
# OPSEVAL_SIMULATOR_BASE_URL=https://api.openai.com/v1
# OPSEVAL_SIMULATOR_MODEL=
# OPSEVAL_SIMULATOR_API_KEY=
# OPSEVAL_JUDGE_BASE_URL=https://api.openai.com/v1
# OPSEVAL_JUDGE_MODEL=
# OPSEVAL_JUDGE_API_KEY=

# The judge must not grade its own vendor family: declare sut_model in profile.yaml and
# pick a judge from another vendor. error (default) refuses the run, warn scores and marks
# results degraded, off disables the check. See ADR-0016.
# OPSEVAL_JUDGE_INDEPENDENCE=error

# Langfuse traces (enable the `traces:` block in profile.yaml).
# OPSEVAL_LANGFUSE_HOST=https://cloud.langfuse.com
# OPSEVAL_LANGFUSE_PUBLIC_KEY=pk-lf-
# OPSEVAL_LANGFUSE_SECRET_KEY=sk-lf-
