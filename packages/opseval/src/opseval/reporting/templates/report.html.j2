<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Opseval report · {{ result.suite }} · {{ result.run_id }}</title>
<style>
:root{--bg:#fbfbfa;--fg:#1d1d1b;--muted:#6b6b66;--line:#e4e3de;--card:#fff;
--pass:#1f7a4d;--fail:#b3261e;--warn:#8a5a00;--info:#3d5a99;--chip:#f1f0ec}
@media (prefers-color-scheme:dark){:root{--bg:#161615;--fg:#ecebe6;--muted:#a3a29c;--line:#2e2e2b;
--card:#1e1e1c;--pass:#5cc493;--fail:#f28b82;--warn:#e7b34d;--info:#9fb7ec;--chip:#2a2a27}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--fg);
font:15px/1.5 system-ui,-apple-system,"Segoe UI","Noto Sans","Noto Sans Arabic",sans-serif}
main{max-width:1080px;margin:0 auto;padding:24px 16px 64px}
h1{font-size:22px;margin:0 0 4px}h2{font-size:18px;margin:32px 0 8px}h3{font-size:15px;margin:16px 0 6px}
.muted{color:var(--muted)}.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px;margin:12px 0}
.gate{border-width:2px}.gate.pass{border-color:var(--pass)}.gate.block{border-color:var(--fail)}.gate.gaps{border-color:var(--warn)}
.badge{display:inline-block;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;background:var(--chip)}
.passed{color:var(--pass)}.failed{color:var(--fail)}.inconclusive,.infra_error,.skipped_precondition,.blocked{color:var(--warn)}
table{width:100%;border-collapse:collapse;font-size:14px}th,td{text-align:start;padding:6px 8px;border-bottom:1px solid var(--line);vertical-align:top}
th{color:var(--muted);font-weight:600}code,pre{font:12px/1.45 ui-monospace,SFMono-Regular,Menlo,monospace}
pre{white-space:pre-wrap;word-break:break-word;background:var(--chip);padding:8px;border-radius:6px;margin:4px 0}
details{margin:6px 0}summary{cursor:pointer}
.bubble{padding:8px 12px;border-radius:10px;margin:6px 0;max-width:85%}
.customer{background:var(--chip);margin-inline-start:auto}.agent{border:1px solid var(--line)}
.who{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.04em}
.decision{font-size:12px;color:var(--info);margin:4px 0}
</style>
</head>
<body><main>
<h1>Opseval report</h1>
<div class="muted">Suite <b>{{ result.suite }}</b> · run <code>{{ result.run_id }}</code> · target <code>{{ result.target }}</code> · profile <code>{{ result.profile }}</code> · Opseval {{ result.opseval_version }}</div>

{% if result.rescore %}
<div class="card"><b>Re-scored offline</b> from run <code>{{ result.rescore.of_run_id }}</code> at {{ result.rescore.rescored_at.strftime('%Y-%m-%d %H:%M UTC') }} (scenarios from the {{ result.rescore.scenario_source }}). The agent was not contacted.
{% if result.rescore.scorer_changes %}<ul>{% for c in result.rescore.scorer_changes %}<li><code>{{ c.scorer_id }}</code> {{ c.what }}: <code>{{ c.before }}</code> → <code>{{ c.after }}</code></li>{% endfor %}</ul>{% else %}<p class="muted" style="margin:4px 0 0">No scorer version or judge prompt changed.</p>{% endif %}
{% if result.rescore.verdict_changes %}<p style="margin:4px 0 0">Verdicts that moved: {% for v in result.rescore.verdict_changes %}<code>{{ v.test_id }}</code> {{ v.before.value }} → <b>{{ v.after.value }}</b>{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
{% if result.rescore.reused_judge_scores %}<p class="muted" style="margin:4px 0 0">{{ result.rescore.reused_judge_scores }} judge score(s) reused from the original run (same prompt, no judge configured).</p>{% endif %}
</div>
{% endif %}
{% if result.gate.status != 'pass' %}{% set card, badge, label = 'block', 'failed', 'RELEASE: BLOCKED' %}
{% elif result.safe_to_release %}{% set card, badge, label = 'pass', 'passed', 'RELEASE: PASS' %}
{% else %}{% set card, badge, label = 'gaps', 'inconclusive', 'RELEASE: PASS WITH GAPS' %}{% endif %}
<div class="card gate {{ card }}">
  <div><span class="badge {{ badge }}">{{ label }}</span>
  <span class="muted">exit code {{ result.exit_code }}</span></div>
  <p style="margin:8px 0 0">{{ result.gate.summary }}</p>
  {% if result.gate.warnings %}<p class="muted" style="margin:4px 0 0">Warnings: {{ result.gate.warnings | join('; ') }}</p>{% endif %}
  {% if result.stopped %}<p class="inconclusive" style="margin:4px 0 0"><strong>Stopped early:</strong> {{ result.stopped.detail }}. Scenarios it did not run are listed as skipped.</p>{% endif %}
  {% if result.gate.policy %}<p class="muted" style="margin:4px 0 0">Gate policy: <code>{{ describe_policy(result.gate.policy) }}</code></p>
  {% set looser = looser_than_standard(result.gate.policy) %}{% if looser %}<p class="inconclusive" style="margin:4px 0 0"><strong>Looser than standard:</strong> {{ looser | join(', ') }}</p>{% endif %}
  {% if result.gate.ignored %}<p class="muted" style="margin:4px 0 0">Ignored by the policy: {{ result.gate.ignored | join('; ') }}</p>{% endif %}{% endif %}
</div>

{% if result.degraded_scorers %}
<div class="card"><h3 class="inconclusive">Degraded evidence</h3>
<p class="muted">These scorers produced a score on weaker evidence than they ask for &mdash;
frame evidence instead of traces, or a judge from the graded model&rsquo;s own vendor family.
<strong>Their scores counted toward the verdict above.</strong></p>
<ul>{% for s in result.degraded_scorers %}<li><code>{{ s }}</code></li>{% endfor %}</ul></div>
{% endif %}

{% if result.unmeasured_scorers %}
<div class="card"><h3 class="inconclusive">Not measured</h3>
<p class="muted">These scorers could not produce a score (harness error) in at least one attempt
that was still judged. <strong>The verdict above was reached without them.</strong></p>
<ul>{% for s in result.unmeasured_scorers %}<li><code>{{ s }}</code></li>{% endfor %}</ul></div>
{% endif %}

{% if result.vacuous_scorers %}
<div class="card"><h3>Passed vacuously</h3>
<p class="muted">These scorers passed because the situation they check never arose &mdash; nothing
forbidden, no matching call, no rule to apply. The passes are honest and they are
<strong>evidence of nothing</strong>.</p>
<ul>{% for s in result.vacuous_scorers %}<li><code>{{ s }}</code></li>{% endfor %}</ul></div>
{% endif %}

{% if result.load_errors %}
<div class="card"><h3 class="inconclusive">Scenarios that could not be loaded (never run)</h3>
<ul>{% for e in result.load_errors %}<li><code>{{ e }}</code></li>{% endfor %}</ul></div>
{% endif %}

<h2>Scenarios</h2>
<table>
<tr><th>Scenario</th><th>Criticality</th><th>Verdict</th><th>Pass rate</th><th>pass^k</th><th>Notes</th></tr>
{% for t in result.tests %}
<tr><td><a href="#{{ t.test_id }}"><code>{{ t.test_id }}</code></a><br><span dir="auto">{{ t.name }}</span></td>
<td>{{ t.criticality.value }}</td>
<td class="{{ t.status.value }}"><b>{{ t.status.value }}</b></td>
<td>{{ t.pass_rate | score }}</td><td>{{ t.pass_hat_k | score }}</td>
<td>{% if t.flaky %}<span class="badge inconclusive">flaky</span> {% endif %}{% if t.degraded_scorers %}<span class="badge">degraded</span> <span class="muted">{{ t.degraded_scorers | join(', ') }}</span> {% endif %}{% if t.unstable_scorers %}<span class="muted">unstable: {{ t.unstable_scorers | join(', ') }}</span>{% endif %}<span class="muted" dir="auto">{{ t.reason or '' }}</span></td></tr>
{% endfor %}
</table>

{% for t in result.tests %}
<h2 id="{{ t.test_id }}"><code>{{ t.test_id }}</code> · <span dir="auto">{{ t.name }}</span> <span class="badge {{ t.status.value }}">{{ t.status.value }}</span></h2>
{% if t.reason %}<p class="muted" dir="auto">{{ t.reason }}</p>{% endif %}
{% for a in t.attempts %}
{% set rec = records.get((t.test_id, a.attempt_index)) %}
<div class="card">
<h3>Attempt {{ a.attempt_index }} ·
{% if a.passed is none %}<span class="inconclusive">not judged</span>{% elif a.passed %}<span class="passed">passed</span>{% else %}<span class="failed">failed</span>{% endif %}
<span class="muted">&nbsp;· ended: {{ a.terminal_state.value }}{% if rec %} ({{ rec.stop_reason }}){% endif %}</span>
{% if rec and rec.trace_coverage == 'full' %}<span class="badge">trace-backed</span>{% endif %}</h3>
{% if a.invalid_reason %}<p class="inconclusive">Invalidated (harness side, not counted against the agent): {{ a.invalid_reason }}</p>{% endif %}
<table>
<tr><th>Check</th><th>Axis</th><th>Result</th><th>Score</th><th>Threshold</th><th>Evidence</th></tr>
{% for s in a.scores %}
<tr><td><code>{{ s.scorer_id }}</code>{% if s.degraded %} <span class="badge">degraded</span>{% endif %}</td><td>{{ s.axis.value }}</td>
<td class="{{ s.status.value }}"><b>{{ s.status.value }}</b></td><td>{{ s.score | score }}</td><td>{{ '%.2f' % s.threshold }}</td>
<td>{% if s.reason %}<div class="inconclusive">{{ s.reason }}</div>{% endif %}{% if s.details %}<details><summary>details</summary><pre dir="auto">{{ s.details | tojson(indent=2) }}</pre></details>{% endif %}</td></tr>
{% endfor %}
</table>
{% if rec %}
<details {% if a.passed is sameas false %}open{% endif %}><summary>Conversation ({{ rec.user_turns }} customer turns, persona {{ rec.persona.language }}{{ '/' ~ rec.persona.dialect if rec.persona.dialect else '' }})</summary>
{% for e in talks[(t.test_id, a.attempt_index)] %}
  {% if e.kind == 'message' %}<div class="bubble {{ e.who }}"><div class="who">{{ e.who }}{% if e.phase %} · {{ e.phase }}{% endif %}{% if e.latency_ms %} · {{ '%.0f' % e.latency_ms }} ms{% endif %}</div><div dir="auto">{{ e.text }}</div></div>
  {% elif e.kind == 'checkpoint' %}<div class="decision">⏸ checkpoint raised: <code>{{ e.detail or '' }}</code></div>
  {% elif e.kind == 'decision' %}<div class="decision">▶ customer decision: <code>{{ e.detail or '' }}</code></div>
  {% else %}<div class="decision{{ ' failed' if e.kind == 'error' else '' }}">{{ {'error': 'error from the agent', 'result': 'result', 'notification': 'notification', 'unknown': 'unclassified frame'}[e.kind] }}: <code>{{ e.detail or '' }}</code></div>{% endif %}
{% endfor %}
{% if rec.infra_errors %}<pre>{{ rec.infra_errors | join('\n') }}</pre>{% endif %}
{% set link = links[(t.test_id, a.attempt_index)] %}{% if link %}<p><strong>Connection:</strong> {{ link | join(' → ') }}</p>{% endif %}
</details>
{% set flow = flows.get((t.test_id, a.attempt_index)) %}
{% if flow %}
<details{% if not flow.clean %} open{% endif %}><summary>Flow map{% if not flow.measured %} — not measured{% elif flow.clean %} — as expected{% elif flow.unexpected %} — {{ flow.unexpected | length }} unexpected transition(s){% else %} — {{ flow.never_reached | length }} phase(s) never reached{% endif %}</summary>
{% if not flow.measured %}
<p class="muted">{{ flow.reason }}</p>
{% else %}
<p><strong>Expected:</strong> {% for p in flow.expected %}<code>{{ p }}</code>{% if not loop.last %} → {% endif %}{% endfor %}</p>
<p><strong>Observed:</strong>
{% for tr in flow.transitions %}<code title="{{ tr.kind.value }}">{{ tr.to }}</code>{% if tr.kind.value != 'expected' %}<span class="badge inconclusive">{{ tr.kind.value }}</span>{% endif %}{% if not loop.last %} → {% endif %}{% endfor %}
</p>
{% if flow.unexpected %}
<table><tr><th>Transition</th><th>What</th><th>Detail</th><th>Frame</th></tr>
{% for tr in flow.unexpected %}
<tr><td><code>{{ tr.frm or '(start)' }}</code> → <code>{{ tr.to }}</code></td>
    <td class="inconclusive">{{ tr.kind.value }}</td>
    <td class="muted">{% if tr.over %}over {{ tr.over | join(', ') }}{% elif tr.kind.value == 'unknown' %}not a declared phase{% endif %}</td>
    <td>#{{ tr.at_seq }}</td></tr>
{% endfor %}
</table>
{% endif %}
{% if flow.never_reached %}<p class="muted">Never reached: {{ flow.never_reached | join(', ') }}</p>{% endif %}
{% if flow.unknown_phases %}<p class="muted">Phases the profile does not declare: {{ flow.unknown_phases | join(', ') }}</p>{% endif %}
{% if flow.ended_at %}<p class="muted">Came to rest in <code>{{ flow.ended_at }}</code>.</p>{% endif %}
{% endif %}
</details>
{% endif %}
{% if rec.trace_coverage == 'full' %}
<details><summary>Tool calls from the agent's trace ({{ rec.tool_calls | length }})</summary>
<table><tr><th>Tool</th><th>Started</th><th>Status</th><th>Arguments</th></tr>
{% for c in rec.tool_calls %}<tr><td><code>{{ c.name }}</code></td><td>{{ c.started_at.isoformat() }}</td><td class="{{ 'passed' if c.ok else 'failed' }}">{{ 'ok' if c.ok else 'error' }}</td><td>{% if c.arguments is not none %}<pre dir="auto">{{ c.arguments | tojson(indent=2) }}</pre>{% endif %}</td></tr>{% endfor %}
</table></details>
{% endif %}
{% if rec.created_artifacts %}<p>Created in the system under test: {% for x in rec.created_artifacts %}<code>{{ x.kind }} {{ x.id }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
{% for n in rec.notes if n.startswith('trace_unavailable') %}<p class="inconclusive">Traces not used: {{ n[19:] }} (tool checks fell back to frame evidence)</p>{% endfor %}
{% endif %}
</div>
{% endfor %}
{% endfor %}

{% if result.usage %}
<h2>LLM usage</h2>
<table><tr><th>Role</th><th>Model</th><th>Calls</th><th>Input tokens</th><th>Output tokens</th><th>Cost (USD)</th></tr>
{% for u in result.usage %}<tr><td>{{ u.role }}</td><td>{{ u.model }}</td><td>{{ u.calls }}</td><td>{{ u.input_tokens }}</td><td>{{ u.output_tokens }}</td><td>{{ 'no rate' if u.cost_usd is none else '%.4f' % u.cost_usd }}</td></tr>{% endfor %}
</table>
{% endif %}

<h2>Configuration (secrets redacted)</h2>
<pre>{{ result.config_digest | tojson(indent=2) }}</pre>
<p class="muted">Generated {{ result.ended_at.isoformat() }} · self-contained, no network requests.</p>
</main></body></html>
