{
  "$defs": {
    "AudioRef": {
      "additionalProperties": false,
      "description": "One turn's audio, kept beside the record (ADR-0053). Caller and agent audio are\nseparate files, so either can be withheld or deleted on its own.\n\nThree states, told apart by ``path`` and ``pruned``: a file (``path`` set), hashes only\n(no path, not pruned: ``OPSEVAL_RECORD_AUDIO=hashes``, or audio that could not be\ndecoded), and pruned (no path, ``pruned``: the file existed and retention removed it).",
      "properties": {
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "codec": {
          "enum": [
            "pcm16",
            "mulaw",
            "alaw"
          ],
          "title": "Codec",
          "type": "string"
        },
        "encryption": {
          "default": "none",
          "enum": [
            "none",
            "aes-256-gcm"
          ],
          "title": "Encryption",
          "type": "string"
        },
        "end_ms": {
          "title": "End Ms",
          "type": "number"
        },
        "key_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{16,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Key Id"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Path"
        },
        "pruned": {
          "default": false,
          "title": "Pruned",
          "type": "boolean"
        },
        "rate": {
          "title": "Rate",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "speaker": {
          "enum": [
            "caller",
            "agent"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        }
      },
      "required": [
        "path",
        "speaker",
        "start_ms",
        "end_ms",
        "sha256",
        "codec",
        "rate",
        "bytes"
      ],
      "title": "AudioRef",
      "type": "object"
    },
    "CreatedArtifact": {
      "additionalProperties": false,
      "description": "Something the agent created during the attempt (FR-REC-01): its kind, its id as the\nagent reported it, and the frame that reported it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "id_redacted": {
          "default": false,
          "title": "Id Redacted",
          "type": "boolean"
        },
        "id_truncated": {
          "default": false,
          "title": "Id Truncated",
          "type": "boolean"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "id",
        "seq"
      ],
      "title": "CreatedArtifact",
      "type": "object"
    },
    "FrameKind": {
      "enum": [
        "user_message",
        "resume",
        "message",
        "needs_human",
        "result",
        "error",
        "notification",
        "handshake",
        "unknown"
      ],
      "title": "FrameKind",
      "type": "string"
    },
    "FrameRecord": {
      "additionalProperties": false,
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "audio": {
          "anyOf": [
            {
              "$ref": "#/$defs/AudioRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direction": {
          "enum": [
            "sent",
            "received"
          ],
          "title": "Direction",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/FrameKind"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "payload": {
          "title": "Payload"
        },
        "phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "transcript": {
          "anyOf": [
            {
              "$ref": "#/$defs/TranscriptInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "seq",
        "at",
        "direction",
        "kind",
        "payload"
      ],
      "title": "FrameRecord",
      "type": "object"
    },
    "InterruptRecord": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action"
        },
        "checkpoint": {
          "title": "Checkpoint",
          "type": "string"
        },
        "decision_seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Seq"
        },
        "expected_target_phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Target Phase"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        },
        "occurrence": {
          "title": "Occurrence",
          "type": "integer"
        },
        "payload": {
          "default": null,
          "title": "Payload"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "via": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Via"
        }
      },
      "required": [
        "seq",
        "checkpoint",
        "occurrence"
      ],
      "title": "InterruptRecord",
      "type": "object"
    },
    "NoiseInfo": {
      "additionalProperties": false,
      "description": "The background noise mixed into the caller's audio (ADR-0055): enough to make it\nagain, bit for bit (generator, kind, seed) and to read a result against it (SNR).",
      "properties": {
        "generator": {
          "title": "Generator",
          "type": "string"
        },
        "kind": {
          "enum": [
            "white",
            "pink",
            "babble"
          ],
          "title": "Kind",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "snr_db": {
          "title": "Snr Db",
          "type": "number"
        }
      },
      "required": [
        "generator",
        "kind",
        "snr_db",
        "seed"
      ],
      "title": "NoiseInfo",
      "type": "object"
    },
    "ProbeResult": {
      "additionalProperties": false,
      "description": "What one protocol probe got back (FR-RUN-07).",
      "properties": {
        "answered": {
          "default": true,
          "title": "Answered",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "received_seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Received Seq"
        },
        "sent_seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sent Seq"
        }
      },
      "required": [
        "name",
        "passed"
      ],
      "title": "ProbeResult",
      "type": "object"
    },
    "RedactionInfo": {
      "additionalProperties": false,
      "description": "What credential values were taken out of this record (FR-REC-03).\n\n``applied`` exists so that an empty ``found`` cannot be misread. On a record written\nbefore value redaction shipped it is ``False``, which means *this was never checked*\n— not \"nothing was there\". That is the same distinction the scores make between\n``failed`` and ``not measured``, applied to the record itself.",
      "properties": {
        "applied": {
          "default": false,
          "title": "Applied",
          "type": "boolean"
        },
        "found": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Found",
          "type": "array"
        }
      },
      "title": "RedactionInfo",
      "type": "object"
    },
    "TerminalState": {
      "enum": [
        "outcome_committed",
        "stopped_at_checkpoint",
        "goal_reached",
        "max_turns_exhausted",
        "error_frame",
        "timeout",
        "transport_failure",
        "harness_failure"
      ],
      "title": "TerminalState",
      "type": "string"
    },
    "ToolCall": {
      "additionalProperties": false,
      "description": "One tool call observed in the agent's own trace.",
      "properties": {
        "arguments": {
          "default": null,
          "title": "Arguments"
        },
        "ended_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "observation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Id"
        },
        "ok": {
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "name",
        "started_at"
      ],
      "title": "ToolCall",
      "type": "object"
    },
    "TranscriptInfo": {
      "additionalProperties": false,
      "description": "Where a turn's ``text`` came from when it was spoken (ADR-0053). ``text`` stays the\nfield every scorer reads; this is the evidence behind it.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "source": {
          "enum": [
            "opseval",
            "agent"
          ],
          "title": "Source",
          "type": "string"
        },
        "words": {
          "default": [],
          "items": {
            "$ref": "#/$defs/WordTiming"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "source"
      ],
      "title": "TranscriptInfo",
      "type": "object"
    },
    "TransportEvent": {
      "additionalProperties": false,
      "description": "Connection-level events: drops, resumes and token refreshes (never token values).",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "attempt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attempt"
        },
        "close_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Close Code"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "kind": {
          "enum": [
            "dropped",
            "resumed",
            "resume_failed",
            "token_refreshed"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "at",
        "kind"
      ],
      "title": "TransportEvent",
      "type": "object"
    },
    "UsageEvent": {
      "additionalProperties": false,
      "description": "One call the harness paid for. Lives in the attempt's record in files mode (ADR-0066).\n\nToken counts follow the OpenAI usage object: ``cached_input_tokens`` is the part of\n``input_tokens`` served from the provider's cache (``prompt_tokens_details.cached_tokens``)\nand ``reasoning_tokens`` the part of ``output_tokens`` spent reasoning\n(``completion_tokens_details.reasoning_tokens``).",
      "properties": {
        "answered": {
          "default": true,
          "title": "Answered",
          "type": "boolean"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "audio_in_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio In Seconds"
        },
        "audio_out_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audio Out Seconds"
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cached Input Tokens"
        },
        "characters": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Characters"
        },
        "cost_source": {
          "default": "unknown",
          "enum": [
            "provider",
            "price_table",
            "unknown"
          ],
          "title": "Cost Source",
          "type": "string"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "latency_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Latency Ms"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "price_from": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Price From"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "rate_limited": {
          "default": 0,
          "title": "Rate Limited",
          "type": "integer"
        },
        "reasoning_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Tokens"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "role": {
          "enum": [
            "simulator",
            "judge",
            "attacker",
            "generator",
            "tts",
            "stt",
            "telephony"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "at",
        "role",
        "model"
      ],
      "title": "UsageEvent",
      "type": "object"
    },
    "VoiceAgentHeard": {
      "additionalProperties": false,
      "description": "One final transcript the agent sent of the caller (``AgentTranscript(of=caller)``),\nstamped on arrival; attributed to a caller turn by time when the metrics are computed.",
      "properties": {
        "at_ms": {
          "minimum": 0,
          "title": "At Ms",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "text"
      ],
      "title": "VoiceAgentHeard",
      "type": "object"
    },
    "VoiceAgentTurn": {
      "additionalProperties": false,
      "description": "One spoken agent turn, as the metrics read it.",
      "properties": {
        "burst": {
          "default": false,
          "title": "Burst",
          "type": "boolean"
        },
        "confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "heard": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Heard"
        },
        "turn": {
          "minimum": 1,
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "turn"
      ],
      "title": "VoiceAgentTurn",
      "type": "object"
    },
    "VoiceBargeIn": {
      "additionalProperties": false,
      "description": "A planted interruption and what became of it.",
      "properties": {
        "after_ms": {
          "minimum": 0,
          "title": "After Ms",
          "type": "integer"
        },
        "agent_turn": {
          "minimum": 1,
          "title": "Agent Turn",
          "type": "integer"
        },
        "ended_at_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended At Ms"
        },
        "fired_at_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fired At Ms"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "agent_turn",
        "after_ms"
      ],
      "title": "VoiceBargeIn",
      "type": "object"
    },
    "VoiceCallerTurn": {
      "additionalProperties": false,
      "description": "One caller turn, as the metrics read it (ADR-0055).",
      "properties": {
        "barge_in": {
          "default": false,
          "title": "Barge In",
          "type": "boolean"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "number"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "turn": {
          "minimum": 1,
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "turn",
        "text",
        "start_ms",
        "end_ms"
      ],
      "title": "VoiceCallerTurn",
      "type": "object"
    },
    "VoiceEventRecord": {
      "additionalProperties": false,
      "properties": {
        "at_ms": {
          "title": "At Ms",
          "type": "number"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "kind": {
          "enum": [
            "speech_start",
            "speech_end",
            "barge_in",
            "dtmf",
            "transfer",
            "hangup",
            "mark",
            "agent_heard"
          ],
          "title": "Kind",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "enum": [
                "caller",
                "agent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        }
      },
      "required": [
        "at_ms",
        "kind"
      ],
      "title": "VoiceEventRecord",
      "type": "object"
    },
    "VoiceMetric": {
      "additionalProperties": false,
      "description": "One raw voice measurement (ADR-0055), the files-mode twin of an ``attempt_metrics`` row\n(ADR-0051): one row per turn for a per-turn metric (``turn`` set), one per attempt for an\nattempt-level one (``turn`` None). Percentiles are computed from the rows by whoever reads\nthem, never stored folded.\n\n``value`` None is **not measured**, and ``reason`` says why; it is never 0. ``degraded``\nmarks a value measured on partial evidence (a gap the clocks could not place was left\nout), and ``reason`` names what was left out.",
      "properties": {
        "degraded": {
          "default": false,
          "title": "Degraded",
          "type": "boolean"
        },
        "name": {
          "enum": [
            "voice.time_to_first_audio_ms",
            "voice.turn_latency_ms",
            "voice.barge_in_yield_ms",
            "voice.talk_over_ratio",
            "voice.dead_air_ms",
            "voice.agent_asr_wer",
            "voice.asr_confidence"
          ],
          "title": "Name",
