    "VoiceSpan": {
      "additionalProperties": false,
      "description": "One stretch of the call on the attempt's monotonic clock (ADR-0055).\n\n``speech``: someone made sound. A caller span is one whole caller turn, from its first\nsample to its last (a planted mid-turn silence included: the caller has not finished);\n``barge_in`` marks the caller's planted interruptions. An agent span is one voiced stretch\nof an agent turn, from its first chunk with energy to the end of its last one as it would\nplay out (a chunk cannot play before it arrives, nor over the one before it), so a turn\nwith pauses is several spans with the same ``turn``. ``harness``: Opseval's own TTS or STT\nwas working; such a span is never the agent's time, and a gap it overlaps cannot be\nplaced (left out, degraded).",
      "properties": {
        "barge_in": {
          "default": false,
          "title": "Barge In",
          "type": "boolean"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "end_ms": {
          "title": "End Ms",
          "type": "number"
        },
        "holds_line": {
          "default": true,
          "title": "Holds Line",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "speech",
            "harness"
          ],
          "title": "Kind",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "enum": [
                "caller",
                "agent"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "number"
        },
        "turn": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn"
        }
      },
      "required": [
        "kind",
        "start_ms",
        "end_ms"
      ],
      "title": "VoiceSpan",
      "type": "object"
    },
