{
  "$defs": {
    "BargeIn": {
      "additionalProperties": false,
      "description": "The caller interrupts one of the agent's spoken turns.",
      "properties": {
        "after_ms": {
          "default": 800,
          "description": "How far into the agent's speech (from its first sample with energy) the caller starts\ntalking.",
          "maximum": 60000,
          "minimum": 0,
          "title": "After Ms",
          "type": "integer"
        },
        "agent_turn": {
          "description": "Which of the agent's spoken turns to interrupt (1 = its first).",
          "maximum": 100,
          "minimum": 1,
          "title": "Agent Turn",
          "type": "integer"
        },
        "say": {
          "description": "What the caller says over the agent. It becomes a customer turn in the record.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Say",
          "type": "string"
        }
      },
      "required": [
        "agent_turn",
        "say"
      ],
      "title": "BargeIn",
      "type": "object"
    },
    "CheckpointPolicy": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/PolicyAction",
          "default": "script"
        },
        "expected_target_phase": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Target Phase"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        },
        "max_rejections": {
          "default": 3,
          "maximum": 20,
          "minimum": 0,
          "title": "Max Rejections",
          "type": "integer"
        },
        "sequence": {
          "items": {
            "$ref": "#/$defs/Decision"
          },
          "title": "Sequence",
          "type": "array"
        },
        "via": {
          "$ref": "#/$defs/DecisionChannel",
          "default": "resume"
        }
      },
      "title": "CheckpointPolicy",
      "type": "object"
    },
    "ConversationSpec": {
      "additionalProperties": false,
      "properties": {
        "allow_commit": {
          "default": false,
          "title": "Allow Commit",
          "type": "boolean"
        },
        "checkpoint_policy": {
          "additionalProperties": {
            "$ref": "#/$defs/CheckpointPolicy"
          },
          "title": "Checkpoint Policy",
          "type": "object"
        },
        "flow": {
          "default": "",
          "title": "Flow",
          "type": "string"
        },
        "injections": {
          "items": {
            "$ref": "#/$defs/Injection"
          },
          "title": "Injections",
          "type": "array"
        },
        "max_turns": {
          "default": 30,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Turns",
          "type": "integer"
        },
        "opening_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Opening Message"
        },
        "scripted_turns": {
          "items": {
            "type": "string"
          },
          "title": "Scripted Turns",
          "type": "array"
        },
        "stop_at": {
          "default": "commit_gate",
          "title": "Stop At",
          "type": "string"
        }
      },
      "title": "ConversationSpec",
      "type": "object"
    },
    "Criticality": {
      "enum": [
        "blocker",
        "critical",
        "normal"
      ],
      "title": "Criticality",
      "type": "string"
    },
    "DatasetSpec": {
      "additionalProperties": false,
      "description": "Rows that one scenario stands for, one expanded scenario per row (ADR-0060).",
      "properties": {
        "allow_blank": {
          "items": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "type": "string"
          },
          "title": "Allow Blank",
          "type": "array"
        },
        "path": {
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "DatasetSpec",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/DecisionAction"
        },
        "feedback": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Feedback"
        }
      },
      "required": [
        "action"
      ],
      "title": "Decision",
      "type": "object"
    },
    "DecisionAction": {
      "enum": [
        "approve",
        "reject"
      ],
      "title": "DecisionAction",
      "type": "string"
    },
    "DecisionChannel": {
      "enum": [
        "resume",
        "user_message"
      ],
      "title": "DecisionChannel",
      "type": "string"
    },
    "Difficulty": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "ExecutionSpec": {
      "additionalProperties": false,
      "properties": {
        "attempt_timeout_seconds": {
          "default": 600.0,
          "exclusiveMinimum": 0,
          "title": "Attempt Timeout Seconds",
          "type": "number"
        },
        "consistency_threshold": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Consistency Threshold",
          "type": "number"
        },
        "repeats": {
          "default": 3,
          "maximum": 20,
          "minimum": 1,
          "title": "Repeats",
          "type": "integer"
        },
        "turn_timeout_seconds": {
          "default": 120.0,
          "exclusiveMinimum": 0,
          "title": "Turn Timeout Seconds",
          "type": "number"
        }
      },
      "title": "ExecutionSpec",
      "type": "object"
    },
    "ExpandedFrom": {
      "additionalProperties": false,
      "description": "Where an expanded scenario came from. Set by the loader, never written by hand.",
      "properties": {
        "base_id": {
          "title": "Base Id",
          "type": "string"
        },
        "dataset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset"
        },
        "dataset_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dataset Digest"
        },
        "hash": {
          "pattern": "^[0-9a-f]{8}$",
          "title": "Hash",
          "type": "string"
        },
        "matrix": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Matrix",
          "type": "object"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        }
      },
      "required": [
        "base_id",
        "hash"
      ],
      "title": "ExpandedFrom",
      "type": "object"
    },
    "Expectations": {
      "additionalProperties": false,
      "properties": {
        "expected_outcome": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Outcome"
        },
        "expected_tools": {
          "$ref": "#/$defs/ExpectedTools"
        },
        "invariants": {
          "items": {
            "type": "string"
          },
          "title": "Invariants",
          "type": "array"
        },
        "kind": {
          "default": "completion",
          "enum": [
            "completion",
            "refusal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "policy": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "title": "Policy",
          "type": "array"
        }
      },
      "title": "Expectations",
      "type": "object"
    },
    "ExpectedTools": {
      "additionalProperties": false,
      "properties": {
        "forbidden_before": {
          "items": {
            "$ref": "#/$defs/ForbiddenBefore"
          },
          "title": "Forbidden Before",
          "type": "array"
        },
        "must_call": {
          "items": {
            "type": "string"
          },
          "title": "Must Call",
          "type": "array"
        },
        "must_not_call": {
          "items": {
            "type": "string"
          },
          "title": "Must Not Call",
          "type": "array"
        },
        "ordering": {
          "items": {
            "$ref": "#/$defs/OrderingRule"
          },
          "title": "Ordering",
          "type": "array"
        }
      },
      "title": "ExpectedTools",
      "type": "object"
    },
    "ForbiddenBefore": {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "title": "Checkpoint",
          "type": "string"
        },
        "tool": {
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "checkpoint"
      ],
      "title": "ForbiddenBefore",
      "type": "object"
    },
    "Injection": {
      "additionalProperties": false,
      "description": "A prompt-injection payload the harness plants, word for word, in one customer turn.",
      "properties": {
        "payload": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Payload",
          "type": "string"
        },
        "turn": {
          "maximum": 100,
          "minimum": 1,
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "turn",
        "payload"
      ],
      "title": "Injection",
      "type": "object"
    },
    "Matrix": {
      "additionalProperties": false,
      "description": "Axes a scenario runs across, one expanded scenario per cell (ADR-0060).",
      "properties": {
        "dialect": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Dialect",
          "type": "array"
        },
        "exclude": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "object"
          },
          "title": "Exclude",
          "type": "array"
        },
        "language": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Language",
          "type": "array"
        },
        "persona": {
          "items": {
            "$ref": "#/$defs/PersonaVariant"
          },
          "title": "Persona",
          "type": "array"
        }
      },
      "title": "Matrix",
      "type": "object"
    },
    "Noise": {
      "additionalProperties": false,
      "description": "Background noise mixed into the caller's audio at a set signal-to-noise ratio.\n\nThe noise is generated, not recorded (no speech, no licence, no size): ``white`` and\n``pink`` are what they say; ``babble`` is several amplitude-modulated, band-limited noise\nvoices, a crowd-like murmur with no words in it. The same ``seed`` gives the same noise.\nIt is mixed into what the agent hears only: the STT canary and every reference text use\nthe caller's clean audio and words.",
      "properties": {
        "kind": {
          "default": "pink",
          "enum": [
            "white",
            "pink",
            "babble"
          ],
          "title": "Kind",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "maximum": 2147483647,
          "minimum": 0,
          "title": "Seed",
          "type": "integer"
        },
        "snr_db": {
          "default": 15.0,
          "description": "Signal-to-noise ratio in dB, measured against the caller's speech.",
          "maximum": 60.0,
          "minimum": -10.0,
          "title": "Snr Db",
          "type": "number"
        }
      },
      "title": "Noise",
      "type": "object"
    },
    "OrderingRule": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "title": "After",
          "type": "string"
        },
        "before": {
          "title": "Before",
          "type": "string"
        }
      },
      "required": [
        "before",
        "after"
      ],
      "title": "OrderingRule",
      "type": "object"
    },
    "Persona": {
      "additionalProperties": false,
      "properties": {
        "dialect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialect"
        },
        "language": {
          "default": "en",
          "title": "Language",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "typing_noise": {
          "default": 0.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Typing Noise",
          "type": "number"
        }
      },
      "required": [
        "role"
      ],
      "title": "Persona",
      "type": "object"
    },
    "PersonaVariant": {
      "additionalProperties": false,
      "description": "One value of the matrix's ``persona`` axis: fields that replace the scenario's own.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,39}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "timezone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timezone"
        },
        "typing_noise": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Typing Noise"
        }
      },
      "title": "PersonaVariant",
      "type": "object"
    },
    "PolicyAction": {
      "enum": [
        "approve",
        "reject",
        "script",
        "sequence"
      ],
      "title": "PolicyAction",
      "type": "string"
    },
    "ScorerSpec": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "threshold": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Threshold",
          "type": "number"
        },
        "weight": {
          "default": 1.0,
          "exclusiveMinimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "id"
      ],
      "title": "ScorerSpec",
      "type": "object"
    },
    "Silence": {
      "additionalProperties": false,
      "description": "The caller says nothing for a while, before speaking or in the middle of a turn.",
      "properties": {
        "at": {
          "default": "mid",
          "description": "``before``: silence, then the whole turn. ``mid``: the turn is cut at its middle word\nand the silence goes between the two halves (a caller pausing mid-sentence).",
          "enum": [
            "before",
            "mid"
          ],
          "title": "At",
          "type": "string"
        },
        "caller_turn": {
          "description": "Which caller turn (1 = the opening message).",
          "maximum": 100,
          "minimum": 1,
          "title": "Caller Turn",
          "type": "integer"
        },
        "ms": {
          "description": "How long the silence lasts.",
          "maximum": 30000,
          "minimum": 50,
          "title": "Ms",
          "type": "integer"
        }
      },
      "required": [
        "caller_turn",
        "ms"
      ],
      "title": "Silence",
      "type": "object"
    },
    "VoiceSpec": {
      "additionalProperties": false,
      "description": "The scenario's ``voice:`` block (ADR-0055).",
      "properties": {
        "barge_in": {
          "description": "Interruptions the caller makes (duplex only).",
          "items": {
            "$ref": "#/$defs/BargeIn"
          },
          "title": "Barge In",
          "type": "array"
        },
        "caller_voice": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The caller's voice: a persona voice name looked up in ``OPSEVAL_TTS_VOICE_MAP`` (then\nthe language, then ``default``), or a provider voice as is. Unset: by language.",
          "title": "Caller Voice"
        },
        "code_switching": {
          "description": "Languages the caller mixes within a sentence (``[ar, en]``): an LLM persona is told to\nswitch between them, and the TTS voice is looked up for the first one, so it must be a\nvoice that speaks all of them (``caller_voice``).",
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Code Switching",
          "type": "array"
        },
        "duplex": {
          "default": false,
          "description": "Run on the full-duplex driver: the caller's audio is paced in real time while the\nagent's is read, so overlap, barge-in and dead air are measured. Implied by\n``barge_in``.",
          "title": "Duplex",
          "type": "boolean"
        },
        "noise": {
          "anyOf": [
            {
              "$ref": "#/$defs/Noise"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "silences": {
          "items": {
            "$ref": "#/$defs/Silence"
          },
          "title": "Silences",
          "type": "array"
        }
      },
      "title": "VoiceSpec",
      "type": "object"
    }
  },
  "$id": "https://opsedia.ai/schemas/v1/scenario.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Opseval opseval/v1 scenario contract. Generated from the Pydantic model; do not edit by hand (run `opseval schemas`).",
  "properties": {
    "conversation": {
      "$ref": "#/$defs/ConversationSpec"
    },
    "criticality": {
      "$ref": "#/$defs/Criticality",
      "default": "normal"
    },
    "dataset": {
      "anyOf": [
        {
          "$ref": "#/$defs/DatasetSpec"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "difficulty": {
      "$ref": "#/$defs/Difficulty",
      "default": "medium"
    },
    "execution": {
      "$ref": "#/$defs/ExecutionSpec"
    },
    "expanded_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExpandedFrom"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expectations": {
      "$ref": "#/$defs/Expectations"
    },
    "goal": {
      "minLength": 1,
      "title": "Goal",
      "type": "string"
    },
    "id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,99}(@[0-9a-f]{8})?$",
      "title": "Id",
      "type": "string"
    },
    "issue_refs": {
      "items": {
        "type": "string"
      },
      "title": "Issue Refs",
      "type": "array"
    },
    "matrix": {
      "anyOf": [
        {
          "$ref": "#/$defs/Matrix"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "persona": {
      "$ref": "#/$defs/Persona"
    },
    "schema": {
      "default": "opseval/v1",
      "title": "Schema",
      "type": "string"
    },
    "scorers": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/ScorerSpec"
          },
          "type": "array"
        },
        {
          "const": "default",
          "type": "string"
        }
      ],
      "default": "default",
      "title": "Scorers"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "voice": {
      "anyOf": [
        {
          "$ref": "#/$defs/VoiceSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "id",
    "name",
    "goal",
    "persona",
    "conversation"
  ],
  "title": "Scenario",
  "type": "object"
}
